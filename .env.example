# Optional Supabase configuration baked into the library at build time.
#
# Copy this file to `.env` (which is gitignored) and fill in your project's
# values to bake them into the build. Apps built against that library can then
# call `sync_default(archive_path, archive_id)` without knowing the URL or key.
# Without a `.env`, the build still succeeds and only the explicit
# `sync(archive_path, remote_url, api_key, archive_id)` is usable.
SUPABASE_URL=https://abc123.supabase.co
SUPABASE_ANON_KEY=your-anon-key
